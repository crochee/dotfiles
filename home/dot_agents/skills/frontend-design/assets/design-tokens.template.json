{
  "meta": {
    "name": "REPLACE-ME",
    "version": "1.0.0"
  },
  "color": {
    "surface": {
      "canvas": { "light": "#ffffff", "dark": "#0e0e11" },
      "raised": { "light": "#f6f6f7", "dark": "#18181c" },
      "sunken": { "light": "#ececed", "dark": "#08080a" },
      "inverse": { "light": "#111113", "dark": "#f5f5f7" }
    },
    "content": {
      "primary": { "light": "#111113", "dark": "#f2f2f4" },
      "secondary": { "light": "#4b4b52", "dark": "#b4b4bd" },
      "muted": { "light": "#6b6b74", "dark": "#8e8e99" },
      "onAccent": { "light": "#ffffff", "dark": "#0e0e11" }
    },
    "accent": {
      "default": { "light": "#1f4fd8", "dark": "#7aa2ff" },
      "hover": { "light": "#1a43b5", "dark": "#9bb8ff" },
      "subtle": { "light": "#e9eefc", "dark": "#1c2740" }
    },
    "border": {
      "default": { "light": "#d9d9de", "dark": "#2c2c33" },
      "strong": { "light": "#8a8a94", "dark": "#6b6b76" },
      "focus": { "light": "#1f4fd8", "dark": "#7aa2ff" }
    },
    "status": {
      "danger": { "light": "#b3261e", "dark": "#ff8a80" },
      "warning": { "light": "#7a4e00", "dark": "#f5b942" },
      "success": { "light": "#14663a", "dark": "#5fd08a" },
      "info": { "light": "#0a58a8", "dark": "#7ab6ff" }
    }
  },
  "typography": {
    "fontFamily": {
      "display": "\"Söhne\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "body": "\"Söhne\", \"Helvetica Neue\", Helvetica, Arial, sans-serif",
      "mono": "\"JetBrains Mono\", \"SFMono-Regular\", Menlo, Consolas, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "3xl": "2rem",
      "4xl": "2.75rem"
    },
    "lineHeight": {
      "tight": "1.15",
      "snug": "1.35",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    },
    "letterSpacing": {
      "tight": "-0.01em",
      "normal": "0",
      "wide": "0.02em"
    }
  },
  "spacing": {
    "0": "0",
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem"
  },
  "radius": {
    "none": "0",
    "sm": "4px",
    "md": "8px",
    "lg": "16px",
    "pill": "999px"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(17, 17, 19, 0.08)",
    "md": "0 4px 16px rgba(17, 17, 19, 0.10)",
    "lg": "0 18px 48px rgba(17, 17, 19, 0.16)"
  },
  "motion": {
    "duration": {
      "fast": "120ms",
      "base": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "entrance": "cubic-bezier(0, 0, 0, 1)",
      "exit": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "group": {
      "hover": { "duration": "fast", "easing": "standard", "property": "opacity, transform" },
      "press": { "duration": "fast", "easing": "standard", "property": "transform" },
      "enter": { "duration": "slow", "easing": "entrance", "property": "opacity, transform" },
      "exit": { "duration": "base", "easing": "exit", "property": "opacity" }
    }
  },
  "breakpoint": {
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "contrast": {
    "body-text": [
      ["content.primary", "surface.canvas"],
      ["content.secondary", "surface.canvas"],
      ["content.muted", "surface.canvas"],
      ["content.primary", "surface.raised"],
      ["content.secondary", "surface.raised"],
      ["content.onAccent", "accent.default"],
      ["status.danger", "surface.canvas"],
      ["status.warning", "surface.canvas"],
      ["status.success", "surface.canvas"],
      ["status.info", "surface.canvas"]
    ],
    "large-text": [
      ["content.secondary", "surface.sunken"],
      ["content.muted", "surface.raised"]
    ],
    "non-text": [
      ["border.strong", "surface.canvas"],
      ["border.focus", "surface.canvas"],
      ["accent.default", "surface.canvas"]
    ],
    "decorative": [
      ["border.default", "surface.canvas"]
    ]
  }
}
