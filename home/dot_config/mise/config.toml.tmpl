# mise is the SINGLE source of truth for tools. Every tool below is pinned to
# `latest` — this is a rolling-tracker config, not a reproducible build, so we
# leave `locked = false` (the default). The auto-generated mise.lock snapshots
# download URLs/checksums per platform, refreshed by `mise upgrade`. Bootstrap-
# pre (git/curl/chezmoi/mise) and bash-completion / zsh plugins live outside
# mise. Docker daemon is owned by bin/docker-daemon; PM docker packages are
# removed by cleanup.sh --only=dups.
#
# `experimental = true` is intentional: it opts us into the lockfile subsystem
# + newer hooks/env-cache features. Flip per-machine via
# `mise settings unset experimental` (config-file marker above stays put).

[settings]
experimental = true
jobs = 8

# Speed: don't auto-install a missing tool on the first invocation. Typing
# `gip` no longer triggers a 30s background install of `ripgrep`; mise errors
# immediately and you can `mise use ripgrep@latest` to opt in. Skip per-project
# with `not_found_auto_install = true` in that dir's .mise.toml.
not_found_auto_install = false

# Quiet: skip the self-update nag (we run `mise self-update` deliberately).
disable_hints = ["self_update"]

[tools]
node = "latest"
python = "latest"
rust = "latest"
go = "latest"
bun = "latest"
uv = "latest"

cargo-binstall = "latest"

"cargo:mcfly" = "latest"
"cargo:starship" = "latest"
"cargo:zoxide" = "latest"
"cargo:bat" = "latest"
"cargo:ripgrep" = "latest"
"cargo:git-delta" = "latest"

"go:sigs.k8s.io/kind" = "latest"
"go:github.com/jesseduffield/lazygit" = "latest"

kubectl = "latest"
neovim = "latest"

# 7zip (Info-ZIP unzip not in registry).
7zip = "latest"

"github:can1357/oh-my-pi" = "latest"

# CLI plugin: docker only loads $DOCKER_CONFIG/cli-plugins/docker-<cmd>.
"aqua:docker/cli" = "latest"
"aqua:docker/buildx" = "latest"

"aqua:mikefarah/yq" = "latest"

# Wox Custom Commands plugin (gopass pwp/pwip/pwu/pwl shortcuts in home/dot_wox/wox-user/shortcuts.json).
"aqua:gopasspw/gopass" = "latest"
"github:gopasspw/gopass-jsonapi" = "latest"

{{ if eq .chezmoi.os "darwin" -}}
# darwin-only: colima runs dockerd inside a Lima VM, so colima + lima are
# pinned together. Without lima, `colima start` fails on `limactl` missing.
"aqua:lima-vm/lima" = "latest"
"aqua:abiosoft/colima" = "latest"
{{ end -}}