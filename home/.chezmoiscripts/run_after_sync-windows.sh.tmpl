{{- /* WSL→Windows mirror for Windows-host-owned tools (wezterm + Wox).
     Linux-side ~/.wox/wox-user/ is chezmoi-managed; this hook mirrors the
     canonical files to the Windows HOME under /mnt/c. settings/wox.json is
     deep-merged (runtime-added keys survive); shortcuts.json is copied
     verbatim (repo canonical) and is the Custom Commands plugin catalog
     (https://github.com/sachadvr/Wox.Custom.Commands.Plugin).
     Verbose gates: WEZTERM_VERBOSE / WOX_VERBOSE (any non-empty value). */ -}}
{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "darwin") -}}
#!/usr/bin/env bash
set -uo pipefail

log() { [[ -n "${1:-}" ]] && shift && printf '%s\n' "$@"; return 0; }
warn() { printf '%s\n' "$@" >&2; }

_log_wezterm() { log "${WEZTERM_VERBOSE:-}" "$@"; }
_log_wox() { log "${WOX_VERBOSE:-}" "$@"; }

case "$(uname -s)" in
    Darwin|Linux) ;;
    *)      warn "windows-host sync: unsupported uname=$(uname -s); skipping"; exit 0 ;;
esac

# --- WSL → Windows mirror ----------------------------------------------------
is_wsl=0
for _m in /mnt/c /mnt/wsl; do [[ -d "$_m" ]] && is_wsl=1 && break; done
[[ $is_wsl -eq 1 ]] || exit 0

# WSL user ≠ Windows account; use /mnt/c/Users owner as the Windows home.
win_home() {
    local owner; owner="$(stat -c '%U' /mnt/c/Users 2>/dev/null || true)"
    if [[ -n "$owner" && "$owner" != "root" ]]; then
        printf '%s' "/mnt/c/Users/${owner}"
    else
        printf '%s' "/mnt/c/Users/${USER}"
    fi
}

sync_wezterm() {
    local src="$HOME/.config/wezterm"
    local dst; dst="$(win_home)/.config/wezterm"
    [[ -d "$src" ]] || { warn "wezterm sync: $src not found"; return 0; }
    [[ -d "$dst" ]] || { _log_wezterm "wezterm sync: $dst not reachable; skipping"; return 0; }

    # *.lua only; --delete mirrors src deletes.
    if command -v rsync >/dev/null 2>&1; then
        if rsync -a --delete --include='*/' --include='*.lua' --exclude='*' \
                "$src/" "$dst/" >/dev/null; then
            _log_wezterm "wezterm sync: done ($src → $dst)"
        else
            warn "wezterm sync: rsync failed; WSL config still authoritative"
        fi
    else
        if (cd "$src" && find . -type f -name '*.lua' -print0) 2>/dev/null \
                | xargs -0 -r cp --target-directory "$dst" --parents 2>/dev/null; then
            _log_wezterm "wezterm sync: done (cp, $src → $dst, *.lua only)"
        else
            warn "wezterm sync: cp fallback failed"
        fi
    fi
}

# Push ~/.wox/wox-user/shortcuts.json into Wox's SQLite plugin_settings table.
# Wox loads the Custom Commands catalog (sachadvr/Wox.Custom.Commands.Plugin)
# via `api.GetSetting(ctx, "shortcuts")`, never from the JSON file on disk — so
# cp'ing the file is necessary-but-not-sufficient. The script handles:
#   - JSON validation + canonical-hash dedup (no rewrite when unchanged)
#   - refusing to write while Wox is running (wox-windows-amd64.exe present)
#   - hardcoded row key (plugin_id + 'shortcuts') — no broad mutations
# If the user has Wox open while this fires, the script warns and exits 1;
# the next `chezmoi apply` (or `~ <script>` once they quit Wox) catches up.
sync_wox_shortcuts_db() {
    local script="$HOME/.local/bin/sync-wox-shortcuts-db"
    [[ -x "$script" ]] || { _log_wox "[windows] sync-wox-shortcuts-db not installed; skipping"; return 0; }
    if "$script"; then
        _log_wox "[windows] sync-wox-shortcuts-db ok"
    else
        warn "[windows] sync-wox-shortcuts-db refused (Wox running?); re-run after quit"
    fi
}

# Linux-side ~/.wox/wox-user/ is chezmoi-managed; mirrors to Windows HOME:
# jq deep-merge for wox.json (runtime-added keys survive), cp for shortcuts.json (repo canonical).
sync_wox_windows() {
    command -v jq >/dev/null 2>&1 || { warn "wox sync: jq missing; skipping"; return 0; }

    local native_user_dir="$HOME/.wox/wox-user"
    local settings_src="${native_user_dir}/settings/wox.json"
    local shortcuts_src="${native_user_dir}/shortcuts.json"

    [[ -f "$settings_src" ]] || { warn "wox sync: $settings_src missing; skipping"; return 0; }

    local win_user_dir; win_user_dir="$(win_home)/.wox/wox-user"
    if [[ ! -d "$(dirname "$win_user_dir")" ]]; then
        warn "wox sync: $(dirname "$win_user_dir") not reachable; Windows-side sync skipped"
        return 0
    fi

    local wox_json="${win_user_dir}/settings/wox.json"
    local changed=0
    mkdir -p "$(dirname "$wox_json")"
    [[ -f "$wox_json" ]] || echo '{}' > "$wox_json"

    # jq deep-merge: repo wins on shared keys, runtime keys survive.
    local tmp; tmp="$(mktemp)"
    local jq_filter='def deepmerge(s;r):
        reduce (r|keys_unsorted[]) as $k (s;
            if (s[$k]|type)=="object" and (r[$k]|type)=="object"
            then .[$k]=deepmerge(s[$k];r[$k])
            else .[$k]=r[$k]
            end);
        $store[0] as $s | $repo[0] as $rp | deepmerge($s;$rp)'
    if ! jq -n --slurpfile store "$wox_json" --slurpfile repo "$settings_src" \
            "$jq_filter" > "$tmp" 2>/dev/null; then
        warn "[windows] jq deep-merge failed; store left unchanged"
        rm -f "$tmp"
    elif [[ "$(jq -cS . "$wox_json" 2>/dev/null)" == "$(jq -cS . "$tmp" 2>/dev/null)" ]]; then
        rm -f "$tmp" # semantically unchanged — leave the store file untouched
    else
        mv "$tmp" "$wox_json"
        _log_wox "[windows] merged $(jq 'keys | length' "$settings_src") top-level keys into $wox_json"
        changed=1
    fi

    local shortcuts_dst="${win_user_dir}/shortcuts.json"
    if [[ -f "$shortcuts_src" ]]; then
        mkdir -p "$(dirname "$shortcuts_dst")"
        if ! cmp -s "$shortcuts_src" "$shortcuts_dst" 2>/dev/null; then
            if cp -f "$shortcuts_src" "$shortcuts_dst"; then
                _log_wox "[windows] copied shortcuts.json -> $shortcuts_dst"
                changed=1
            else
                warn "[windows] shortcuts.json copy failed"
            fi
        fi
    fi

    [[ $changed -eq 0 ]] && _log_wox "[windows] in sync"
}

sync_wezterm
sync_wox_windows
sync_wox_shortcuts_db
_log_wezterm "windows-host sync: done"
exit 0
{{ end -}}
