# ~/.system/shell.bash.sh — sourced by ~/.bashrc.
# Init order: mise activate → starship → zoxide → bash-completion → mcfly.
# `mise activate --shims` is the canonical mise activation site (~10ms cold).
# Each shim is a symlink to the mise binary; first invocation resolves `latest`
# to a concrete version and caches it. Full `mise activate` would add ~400ms
# to every shell start, so we keep shim-mode + path-only setup. No [env] blocks
# in mise.toml, so shim-mode is sufficient.
# shellcheck shell=bash disable=SC2148

stty -ixon 2>/dev/null || true

eval "$(mise activate --shims bash)"
eval "$(starship init bash)"
eval "$(zoxide init --cmd cd bash)"

for _bc in \
    /usr/share/bash-completion/bash_completion \
    /opt/homebrew/share/bash-completion/bash_completion \
    /usr/local/share/bash-completion/bash_completion; do
    # shellcheck disable=SC1090  # platform-dependent source path.
    [ -r "$_bc" ] && { . "$_bc"; break; }
done
unset _bc

export HISTFILE="${XDG_STATE_HOME:-$HOME/.local/state}/bash/history"
export HISTSIZE=10000 HISTCONTROL=ignoreboth
mkdir -p "${HISTFILE%/*}"
[ -e "$HISTFILE" ] || : >> "$HISTFILE"
shopt -s histappend
# cmdhist OFF: bracketed paste collapses to one multi-line entry, then Up floods readline with ^J.
shopt -u cmdhist

eval "$(mcfly init bash)"