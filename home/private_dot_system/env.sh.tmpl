# ~/.system/env.sh — login + interactive rc. Idempotent. Per-machine values come from
# .chezmoidata/{defaults,local}.yaml under `env:` (see defaults.yaml header).
# shellcheck shell=bash disable=SC2148
[ -n "${__DOTFILES_SOURCED_env_sh:-}" ] && return 0
__DOTFILES_SOURCED_env_sh=1

export DOTFILES_DIR="{{ .chezmoi.workingTree | default (.chezmoi.sourceDir | dir) }}"
export WORKSPACE="$HOME/workspace"
: "${XDG_CONFIG_HOME:=$HOME/.config}"
: "${XDG_CACHE_HOME:=$HOME/.cache}"
: "${XDG_DATA_HOME:=$HOME/.local/share}"
: "${XDG_STATE_HOME:=$HOME/.local/state}"
export XDG_CONFIG_HOME XDG_CACHE_HOME XDG_DATA_HOME XDG_STATE_HOME
mkdir -p "$WORKSPACE" "$XDG_CACHE_HOME" "$XDG_DATA_HOME" "$XDG_STATE_HOME"

for _pe in \
    "$HOME/.local/share/mise/shims" \
    "$HOME/.local/bin" \
    "$HOME/.local/share/nvim/mason/bin" \
    "$DOTFILES_DIR/bin" \
    "$HOME/.cargo/bin" \
    /opt/homebrew/bin \
    /home/linuxbrew/.linuxbrew/bin \
    /usr/local/bin; do
    case ":$PATH:" in
        *":$_pe:"*) ;;
        *) [ -d "$_pe" ] && PATH="$_pe:$PATH" ;;
    esac
done
unset _pe

export _ZO_ECHO=1 _ZO_MAXAGE=10000 _ZO_DOCTOR=0
export CLICOLOR=1
: "${LANG:=C.UTF-8}"
export LANG
export EDITOR=nvim
export VISUAL=nvim
: "${TERM:=xterm-256color}"
export TERM
export LESS="-R"
export GREP_COLORS='ms=36;40'

# per-machine env: defaults.yaml + local.yaml `env:` map (same-key local wins).
{{- $env := dict -}}
{{- if hasKey . "env" -}}
{{- $env = .env -}}
{{- end -}}
{{- range $name, $value := $env }}
{{- if $value }}
export {{ $name }}={{ $value | quote }}
{{- end }}
{{- end }}

# WSLg: surface the Wayland socket at $XDG_RUNTIME_DIR for wl-copy etc.
if [ -S /mnt/wslg/runtime-dir/wayland-0 ] && [ -n "$XDG_RUNTIME_DIR" ]; then
    case "${WAYLAND_DISPLAY:-}" in
        ''|wayland-0)
            export WAYLAND_DISPLAY=wayland-0
            [ -S "$XDG_RUNTIME_DIR/wayland-0" ] || \
                ln -snf /mnt/wslg/runtime-dir/wayland-0 "$XDG_RUNTIME_DIR/wayland-0"
            ;;
    esac
fi