{{- /* Quiver version tag: .chezmoidata/defaults.yaml:quiver — the tag in the
     release URL is the only update/sync signal; no checksums.
     linux/darwin only — Windows side mirrored by run_after_apply_*.sh.tmpl. */ -}}
{{- $q := .quiver -}}
{{- $quiverAsset := "" -}}
{{- if eq .chezmoi.os "linux" -}}
{{-   if eq .chezmoi.arch "amd64" -}}
{{-     $quiverAsset = "quiver-x86_64-unknown-linux-gnu" -}}
{{-   end -}}
{{- else if eq .chezmoi.os "darwin" -}}
{{-   if eq .chezmoi.arch "arm64" -}}
{{-     $quiverAsset = "quiver-aarch64-apple-darwin" -}}
{{-   end -}}
{{- end -}}
{{- if $quiverAsset }}

[".local/bin/quiver"]
    type = "file"
    url = "https://github.com/crochee/quiver/releases/download/v{{ $q.version }}/{{ $quiverAsset }}"
    executable = true
    refreshPeriod = "168h"
{{- end }}