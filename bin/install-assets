#!/usr/bin/env bash
# 把本仓库的 agents/ 或 skills/ 以符号链接装进目标编辑器的对应目录。
# 仓库是唯一源：链接后在本仓库的修改即时生效，无需重装。
#
# 用法:
#   install-assets <agents|skills> <editor> [-f] [-d]
#
#   editor  目标编辑器名（claude -> ~/.claude），也可直接给绝对/~/ 开头的目录
#   -f      清空目标目录后全量链接
#   -d      删除目标中与源同名的条目（不与 -f 连用时到此为止）

set -euo pipefail

DOTFILES="$(cd "$(dirname "$0")/.." && pwd)"

KIND=""
EDITOR_NAME=""
FORCE=0
DELETE_MODE=0

usage() {
    sed -n '3,10p' "$0" | sed 's/^# \{0,1\}//;s/^#//'
    exit 1
}

while [ $# -gt 0 ]; do
    case "$1" in
        -f) FORCE=1 ;;
        -d) DELETE_MODE=1 ;;
        -*) usage ;;
        *)
            if [ -z "$KIND" ]; then
                KIND="$1"
            elif [ -z "$EDITOR_NAME" ]; then
                EDITOR_NAME="$1"
            else
                usage
            fi
            ;;
    esac
    shift
done

[ -n "$KIND" ] && [ -n "$EDITOR_NAME" ] || usage

case "$KIND" in
    agents) SOURCE_DIR="$DOTFILES/agents" ;;
    skills) SOURCE_DIR="$DOTFILES/skills" ;;
    *) usage ;;
esac

[ -d "$SOURCE_DIR" ] || { echo "Error: source $SOURCE_DIR not found" >&2; exit 1; }

case "$EDITOR_NAME" in
    /*) TARGET_DIR="$EDITOR_NAME" ;;
    ~/*) TARGET_DIR="${EDITOR_NAME/#\~/$HOME}" ;;
    *) TARGET_DIR="$HOME/.$EDITOR_NAME/$KIND" ;;
esac

# 收集条目：agents 收 *.md（名字去掉扩展名），skills 收子目录
declare -A ITEMS
if [ "$KIND" = agents ]; then
    for item in "$SOURCE_DIR"/*.md; do
        [ -f "$item" ] || continue
        ITEMS["$(basename "$item" .md)"]="$item"
    done
else
    for item in "$SOURCE_DIR"/*/; do
        [ -d "$item" ] || continue
        ITEMS["$(basename "$item")"]="$item"
    done
fi
[ ${#ITEMS[@]} -gt 0 ] || { echo "Error: no $KIND found in $SOURCE_DIR" >&2; exit 1; }

names() { printf '%s\n' "${!ITEMS[@]}" | sort; }

dst_of() { # 名字 -> 目标路径（agents 落地为 <name>.md，skills 为 <name>/）
    if [ "$KIND" = agents ]; then
        printf '%s/%s.md' "$TARGET_DIR" "$1"
    else
        printf '%s/%s' "$TARGET_DIR" "$1"
    fi
}

if [ "$DELETE_MODE" -eq 1 ]; then
    [ -d "$TARGET_DIR" ] || { echo "Error: $TARGET_DIR does not exist" >&2; exit 1; }
    removed=0
    for name in $(names); do
        if [ -e "$(dst_of "$name")" ] || [ -L "$(dst_of "$name")" ]; then
            echo "  Removing: $name"
            rm -rf "${TARGET_DIR:?}/$name.md" "${TARGET_DIR:?}/$name"
            removed=$((removed + 1))
        else
            echo "  Skipping: $name (not installed)"
        fi
    done
    echo "Done: $removed removed"
    [ "$FORCE" -eq 0 ] && exit 0
fi

mkdir -p "$TARGET_DIR"
[ "$FORCE" -eq 1 ] && find "$TARGET_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf {} +

echo "Linking ${#ITEMS[@]} $KIND into $TARGET_DIR ..."
for name in $(names); do
    src="${ITEMS[$name]}"
    dst=$(dst_of "$name")
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then
        echo "  $name (already linked)"
        continue
    fi
    # 占位的旧拷贝/旧链接先移除（只动与源同名的条目）
    rm -rf "${TARGET_DIR:?}/$name.md" "${TARGET_DIR:?}/$name"
    ln -s "$src" "$dst"
    echo "  $name -> $src"
done
echo "Done: ${#ITEMS[@]} $KIND linked"
