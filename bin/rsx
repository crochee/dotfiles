#!/usr/bin/env bash
# rsx — WSL → Windows rsync. Rewrites the first WSL-internal path to UNC.
# Windows user: $RSYNC_CMD > $WINUSER > ask Windows > $USER.
set -e

if [ -z "${RSYNC_CMD:-}" ]; then
    win_user="${WINUSER:-}"
    if [ -z "$win_user" ] && command -v cmd.exe >/dev/null 2>&1; then
        win_user=$(cmd.exe /c 'echo %USERNAME%' 2>/dev/null | tr -d '\r\n' || true)
    fi
    [ -n "$win_user" ] || win_user="$USER"
    RSYNC_CMD="/mnt/c/Users/$win_user/.local/bin/rsync/bin/rsync.exe"
fi

args=("$@")
local_path_index=-1
for i in "${!args[@]}"; do
    _p="${args[i]}"
    [[ "$_p" != -* ]] && [[ -e "$_p" ]] || continue
    [[ "$_p" == /mnt/* ]] && continue
    local_path_index=$i
    break
done

if [ "$local_path_index" -ge 0 ]; then
    args[local_path_index]="//wsl.localhost/${WSL_DISTRO_NAME:?rsx 需在 WSL 内运行}$(realpath "${args[$local_path_index]}")"
fi

if [ ! -x "$RSYNC_CMD" ]; then
    echo "rsx: rsync 二进制 $RSYNC_CMD 不存在或不可执行 (设置 RSYNC_CMD 或 WINUSER)" >&2
    exit 1
fi
"$RSYNC_CMD" "${args[@]}"